{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@familieappen/shared": ["packages/shared/src/index.ts"],
      "@familieappen/ui": ["packages/ui/src/index.ts"]
    }
  }
}
