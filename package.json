{
  "name": "familieappen",
  "version": "0.1.0",
  "private": true,
  "description": "Lean fullstack monorepo foundation for FamilieAppen.",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:mobile": "pnpm --filter @familieappen/mobile start",
    "dev:api": "pnpm --filter @familieappen/api start:dev",
    "start:api": "pnpm --filter @familieappen/api start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
