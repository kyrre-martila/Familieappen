# FamilieAppen production Compose environment example.
# Copy to the server's uncommitted .env file next to docker-compose.prod.yml.
# Do not commit real production values or generated secrets.

# PostgreSQL password used by the db service and API DATABASE_URL.
POSTGRES_PASSWORD=

# Secret used to sign normal user access tokens. Must be a long random value.
AUTH_JWT_SECRET=

# Separate admin-session secret. Must be a long random value and must not be committed.
# Changing this value invalidates existing admin sessions.
ADMIN_SESSION_SECRET=

# Admin session lifetime in seconds. Defaults to 604800 (7 days) in Compose.
ADMIN_SESSION_TTL=604800
