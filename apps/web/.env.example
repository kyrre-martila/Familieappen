# FamilieAppen Web environment
# Copy to apps/web/.env.local for local development. Do not commit real secrets.

# Public app URL used when constructing absolute links outside the request context.
APP_BASE_URL=

# Email delivery. Leave EMAIL_PROVIDER empty locally to use dev-log mode.
EMAIL_PROVIDER=
EMAIL_FROM_NAME=FamilieAppen
EMAIL_FROM_ADDRESS=noreply@familieappen.no

# Provider-specific placeholders. Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Calm support contact shown in App-info.
SUPPORT_EMAIL=kontakt@familieappen.no
NEXT_PUBLIC_SUPPORT_EMAIL=kontakt@familieappen.no
