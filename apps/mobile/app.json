{
  "expo": {
    "name": "FamilieAppen",
    "slug": "familieappen",
    "scheme": "familieappen",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store", "expo-splash-screen", "expo-notifications"],
    "splash": { "backgroundColor": "#fffaf3", "resizeMode": "contain" },
    "ios": { "supportsTablet": true },
    "android": { "adaptiveIcon": { "backgroundColor": "#fffaf3" } },
    "web": { "bundler": "metro" }
  }
}
