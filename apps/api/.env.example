# FamilieAppen API environment
# Copy to apps/api/.env for local development. Do not commit real secrets.

# Runtime environment. Local-safe defaults are only applied for development and test.
NODE_ENV="development"

# HTTP port used by the NestJS API. Defaults to 4000 locally.
PORT="4000"

# Global API route prefix. The default exposes routes under /api.
# Leading/trailing slashes are trimmed, so "/api/" becomes "api".
API_PREFIX="api"

# Comma-separated browser origins allowed by CORS.
# Entries must be bare http(s) origins without paths, queries, or trailing slash.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL connection string used by Prisma CLI and the API runtime.
# Local development/test default when omitted:
# postgresql://postgres:postgres@localhost:5432/familieappen?schema=public
# Required outside development/test.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familieappen?schema=public"

# Secret used to sign custom auth access tokens.
# Local development/test default when omitted:
# familieappen-development-auth-secret-change-me
# Required outside development/test, must be at least 32 characters, and must not use
# placeholders or the documented local default. Generate a deployment value with e.g.:
# openssl rand -base64 48
AUTH_JWT_SECRET="familieappen-development-auth-secret-change-me"
