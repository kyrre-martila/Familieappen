generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FamilyMemberRole {
  OWNER
  PARENT
  CHILD
  GUEST
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  FamilyMember[]
  createdShoppingItems ShoppingListItem[] @relation("ShoppingItemCreatedBy")
  checkedShoppingItems ShoppingListItem[] @relation("ShoppingItemCheckedBy")
  createdTasks Task[] @relation("TaskCreatedBy")
  completedTasks Task[] @relation("TaskCompletedBy")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreatedBy")
  createdReminders Reminder[] @relation("ReminderCreatedBy")
  wishlistItems WishlistItem[] @relation("WishlistItemOwnerUser")
  wishlistItemReservations WishlistItemReservation[] @relation("WishlistItemReservationReservedByUser")

  @@map("users")
}

model Family {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   FamilyMember[]
  shoppingLists ShoppingList[]
  mealPlans MealPlan[]
  meals MealPlanDay[]
  tasks     Task[]
  calendarEvents CalendarEvent[]
  reminders Reminder[]
  lists     List[]
  wishlistItems WishlistItem[]
  schoolWeekReminders SchoolWeekReminder[]
  createdMealPlanDays MealPlanDay[]

  @@map("families")
}

model FamilyMember {
  id          String           @id @default(cuid())
  userId      String?
  familyId    String
  displayName String
  role        FamilyMemberRole
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  calendarEventParticipants CalendarEventParticipant[]
  reminderAudienceMembers ReminderAudienceMember[]
  listAudienceMembers ListAudienceMember[]
  assignedListItems ListItem[]
  wishlistItems WishlistItem[]
  schoolWeekReminders SchoolWeekReminder[]
  createdMealPlanDays MealPlanDay[]

  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model ShoppingList {
  id        String             @id @default(cuid())
  familyId  String             @unique
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  family    Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@index([familyId])
  @@map("shopping_lists")
}
model ShoppingListItem {
  id               String       @id @default(cuid())
  shoppingListId   String
  label            String
  quantity         String?
  checked          Boolean      @default(false)
  createdByUserId  String?
  checkedByUserId  String?
  checkedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  shoppingList     ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  createdByUser    User?        @relation("ShoppingItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  checkedByUser    User?        @relation("ShoppingItemCheckedBy", fields: [checkedByUserId], references: [id], onDelete: SetNull)

  @@index([shoppingListId])
  @@index([createdByUserId])
  @@index([checkedByUserId])
  @@map("shopping_list_items")
}

model MealPlan {
  id        String        @id @default(cuid())
  familyId  String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  days      MealPlanDay[]

  @@index([familyId])
  @@map("meal_plans")
}

model MealPlanDay {
  id                      String        @id @default(cuid())
  mealPlanId              String
  familyId                String
  date                    DateTime
  mealName                String
  notes                   String?
  createdByFamilyMemberId String?
  sortOrder               Int?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?
  mealPlan                MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  family                  Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByFamilyMember   FamilyMember? @relation(fields: [createdByFamilyMemberId], references: [id], onDelete: SetNull)

  @@unique([familyId, date])
  @@unique([mealPlanId, date])
  @@index([mealPlanId])
  @@index([familyId])
  @@index([createdByFamilyMemberId])
  @@index([date])
  @@index([deletedAt])
  @@map("meal_plan_days")
}

model Task {
  id                     String        @id @default(cuid())
  familyId               String
  title                  String
  description            String?
  assignedFamilyMemberId String?
  createdByUserId        String?
  completed              Boolean       @default(false)
  completedAt            DateTime?
  completedByUserId      String?
  dueDate                DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  family                 Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignedFamilyMember   FamilyMember? @relation(fields: [assignedFamilyMemberId], references: [id], onDelete: SetNull)
  createdByUser          User?         @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUser        User?         @relation("TaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([assignedFamilyMemberId])
  @@index([createdByUserId])
  @@index([completedByUserId])
  @@map("tasks")
}


model CalendarEvent {
  id              String                     @id @default(cuid())
  familyId        String
  title           String
  description     String?
  location        String?
  icon            String                     @default("family")
  reminderMinutesBefore Int?
  startsAt        DateTime
  endsAt          DateTime?
  allDay          Boolean                    @default(false)
  createdByUserId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  family          Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByUser   User?                      @relation("CalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants    CalendarEventParticipant[]

  @@index([familyId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdByUserId])
  @@map("calendar_events")
}

model CalendarEventParticipant {
  id             String         @id @default(cuid())
  eventId        String
  familyMemberId String
  createdAt      DateTime       @default(now())
  event          CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember   @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, familyMemberId])
  @@index([eventId])
  @@index([familyMemberId])
  @@map("calendar_event_participants")
}



model Reminder {
  id              String                   @id @default(cuid())
  familyId        String
  title           String
  icon            String                   @default("backpack")
  dueDate         DateTime
  reminderMinutesBefore Int?
  note            String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  archivedAt      DateTime?
  family          Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByUser   User?                    @relation("ReminderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  audienceMembers ReminderAudienceMember[]

  @@index([familyId])
  @@index([dueDate])
  @@index([createdByUserId])
  @@map("reminders")
}

model ReminderAudienceMember {
  id             String       @id @default(cuid())
  reminderId     String
  familyMemberId String
  createdAt      DateTime     @default(now())
  reminder       Reminder     @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([reminderId, familyMemberId])
  @@index([reminderId])
  @@index([familyMemberId])
  @@map("reminder_audience_members")
}

model List {
  id              String               @id @default(cuid())
  familyId        String
  title           String
  icon            String               @default("home")
  description     String?
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  audienceMembers ListAudienceMember[]
  items           ListItem[]

  @@index([familyId])
  @@map("husk_lists")
}

model ListAudienceMember {
  id             String       @id @default(cuid())
  listId         String
  familyMemberId String
  createdAt      DateTime     @default(now())
  list           List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([listId, familyMemberId])
  @@index([listId])
  @@index([familyMemberId])
  @@map("husk_list_audience_members")
}

model ListItem {
  id                     String        @id @default(cuid())
  listId                 String
  title                  String
  description            String?
  completedAt            DateTime?
  assignedFamilyMemberId String?
  dueDate                DateTime?
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  list                   List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignedFamilyMember   FamilyMember? @relation(fields: [assignedFamilyMemberId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([assignedFamilyMemberId])
  @@map("husk_list_items")
}

model WishlistItemReservation {
  id                 String       @id @default(cuid())
  wishlistItemId     String       @map("wishlist_item_id")
  reservedByUserId   String       @map("reserved_by_user_id")
  reservedAt         DateTime     @default(now()) @map("reserved_at")
  releasedAt         DateTime?    @map("released_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  wishlistItem       WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)
  reservedByUser     User         @relation("WishlistItemReservationReservedByUser", fields: [reservedByUserId], references: [id], onDelete: Cascade)

  @@index([wishlistItemId])
  @@index([reservedByUserId])
  @@index([wishlistItemId, releasedAt])
  @@map("wishlist_item_reservations")
}

model SchoolWeekReminder {
  id                    String                @id @default(cuid())
  familyId              String
  childFamilyMemberId   String
  title                 String
  icon                  String                @default("backpack")
  weekday               String
  date                  DateTime?
  isRecurring           Boolean               @default(false)
  recurrenceFrequency   String                @default("weekly")
  recurrenceEndDate     DateTime?
  recurringSeriesId     String?
  exceptionOfId         String?
  note                  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  family                Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childFamilyMember     FamilyMember          @relation(fields: [childFamilyMemberId], references: [id], onDelete: Cascade)
  exceptionOf           SchoolWeekReminder?   @relation("SchoolWeekReminderExceptions", fields: [exceptionOfId], references: [id], onDelete: Cascade)
  exceptions            SchoolWeekReminder[]  @relation("SchoolWeekReminderExceptions")

  @@index([familyId])
  @@index([childFamilyMemberId])
  @@index([date])
  @@index([exceptionOfId])
  @@index([recurringSeriesId])
  @@map("school_week_reminders")
}

model WishlistItem {
  id                    String        @id @default(cuid())
  familyId              String        @map("family_id")
  ownerUserId           String        @map("owner_user_id")
  ownerFamilyMemberId   String?       @map("owner_family_member_id")
  title                 String
  description           String?
  price                 Decimal?      @db.Decimal(10, 2)
  storeOrLink           String?       @map("store_or_link")
  imageUrl              String?       @map("image_url")
  icon                  String?
  position              Int
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  family                Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ownerUser             User          @relation("WishlistItemOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerFamilyMember     FamilyMember? @relation(fields: [ownerFamilyMemberId], references: [id], onDelete: SetNull)
  reservations          WishlistItemReservation[]

  @@index([familyId])
  @@index([ownerUserId])
  @@index([ownerFamilyMemberId])
  @@index([familyId, ownerUserId, deletedAt, position])
  @@map("wishlist_items")
}
