generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FamilyMemberRole {
  OWNER
  PARENT
  CHILD
  GUEST
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  FamilyMember[]
  createdShoppingItems ShoppingListItem[] @relation("ShoppingItemCreatedBy")
  checkedShoppingItems ShoppingListItem[] @relation("ShoppingItemCheckedBy")
  createdTasks Task[] @relation("TaskCreatedBy")
  completedTasks Task[] @relation("TaskCompletedBy")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreatedBy")
  createdWishlists Wishlist[] @relation("WishlistCreatedBy")
  wishlistReservations WishlistReservation[] @relation("WishlistReservationReservedBy")

  @@map("users")
}

model Family {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   FamilyMember[]
  shoppingLists ShoppingList[]
  mealPlans MealPlan[]
  tasks     Task[]
  calendarEvents CalendarEvent[]
  wishlists Wishlist[]

  @@map("families")
}

model FamilyMember {
  id          String           @id @default(cuid())
  userId      String?
  familyId    String
  displayName String
  role        FamilyMemberRole
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  calendarEventParticipants CalendarEventParticipant[]
  ownedWishlists Wishlist[]

  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model ShoppingList {
  id        String             @id @default(cuid())
  familyId  String             @unique
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  family    Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@index([familyId])
  @@map("shopping_lists")
}
model ShoppingListItem {
  id               String       @id @default(cuid())
  shoppingListId   String
  label            String
  quantity         String?
  checked          Boolean      @default(false)
  createdByUserId  String?
  checkedByUserId  String?
  checkedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  shoppingList     ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  createdByUser    User?        @relation("ShoppingItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  checkedByUser    User?        @relation("ShoppingItemCheckedBy", fields: [checkedByUserId], references: [id], onDelete: SetNull)

  @@index([shoppingListId])
  @@index([createdByUserId])
  @@index([checkedByUserId])
  @@map("shopping_list_items")
}

model MealPlan {
  id        String        @id @default(cuid())
  familyId  String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  days      MealPlanDay[]

  @@index([familyId])
  @@map("meal_plans")
}

model MealPlanDay {
  id         String   @id @default(cuid())
  mealPlanId String
  date       DateTime
  mealName   String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, date])
  @@index([mealPlanId])
  @@index([date])
  @@map("meal_plan_days")
}

model Task {
  id                     String        @id @default(cuid())
  familyId               String
  title                  String
  description            String?
  assignedFamilyMemberId String?
  createdByUserId        String?
  completed              Boolean       @default(false)
  completedAt            DateTime?
  completedByUserId      String?
  dueDate                DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  family                 Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignedFamilyMember   FamilyMember? @relation(fields: [assignedFamilyMemberId], references: [id], onDelete: SetNull)
  createdByUser          User?         @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUser        User?         @relation("TaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([assignedFamilyMemberId])
  @@index([createdByUserId])
  @@index([completedByUserId])
  @@map("tasks")
}


model CalendarEvent {
  id              String                     @id @default(cuid())
  familyId        String
  title           String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime?
  allDay          Boolean                    @default(false)
  createdByUserId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  family          Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByUser   User?                      @relation("CalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants    CalendarEventParticipant[]

  @@index([familyId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdByUserId])
  @@map("calendar_events")
}

model CalendarEventParticipant {
  id             String         @id @default(cuid())
  eventId        String
  familyMemberId String
  createdAt      DateTime       @default(now())
  event          CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember   @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, familyMemberId])
  @@index([eventId])
  @@index([familyMemberId])
  @@map("calendar_event_participants")
}


model Wishlist {
  id                  String               @id @default(cuid())
  familyId            String
  ownerFamilyMemberId String
  title               String
  description         String?
  createdByUserId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  family              Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ownerFamilyMember   FamilyMember         @relation(fields: [ownerFamilyMemberId], references: [id], onDelete: Cascade)
  createdByUser       User?                @relation("WishlistCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items               WishlistItem[]
  shares              WishlistShare[]

  @@index([familyId])
  @@index([ownerFamilyMemberId])
  @@index([createdByUserId])
  @@map("wishlists")
}

model WishlistItem {
  id             String                @id @default(cuid())
  wishlistId     String
  title          String
  description    String?
  productUrl     String?
  imageUrl       String?
  estimatedPrice String?
  purchased      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  wishlist       Wishlist              @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  reservations   WishlistReservation[]

  @@index([wishlistId])
  @@map("wishlist_items")
}

model WishlistReservation {
  id                String       @id @default(cuid())
  wishlistItemId    String
  reservedByUserId  String?
  reservedByName    String?
  purchased         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  wishlistItem      WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)
  reservedByUser    User?        @relation("WishlistReservationReservedBy", fields: [reservedByUserId], references: [id], onDelete: SetNull)

  @@index([wishlistItemId])
  @@index([reservedByUserId])
  @@map("wishlist_reservations")
}

model WishlistShare {
  id         String    @id @default(cuid())
  wishlistId String
  token      String    @unique
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@index([wishlistId])
  @@index([token])
  @@map("wishlist_shares")
}
