generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FamilyMemberRole {
  OWNER
  PARENT
  CHILD
  GUEST
}

enum WishlistShareInvitationStatus {
  pending
  accepted
  declined
  removed
  revoked
}

enum ShoppingListInvitationStatus {
  pending
  accepted
  declined
  revoked
}

enum FamilyInvitationStatus {
  pending
  accepted
  declined
  revoked
}

enum FamilyInvitationSource {
  admin_invite
  join_request
}

enum FeedbackSubmissionType {
  feedback
  bug
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  firstName    String         @default("")
  middleName   String?
  lastName     String         @default("")
  displayName  String         @default("")
  avatarUrl    String?
  phone        String?
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  FamilyMember[]
  createdShoppingItems ShoppingListItem[] @relation("ShoppingItemCreatedBy")
  customShoppingItems FamilyCustomShoppingItem[] @relation("FamilyCustomShoppingItemCreatedBy")
  checkedShoppingItems ShoppingListItem[] @relation("ShoppingItemCheckedBy")
  ownedShoppingLists ShoppingList[] @relation("ShoppingListOwnerUser")
  shoppingListAccesses ShoppingListAccess[]
  sentShoppingListInvitations ShoppingListInvitation[] @relation("ShoppingListInvitationCreatedByUser")
  receivedShoppingListInvitations ShoppingListInvitation[] @relation("ShoppingListInvitationInvitedUser")
  createdTasks Task[] @relation("TaskCreatedBy")
  completedTasks Task[] @relation("TaskCompletedBy")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreatedBy")
  createdReminders Reminder[] @relation("ReminderCreatedBy")
  wishlistItems WishlistItem[] @relation("WishlistItemOwnerUser")
  wishlistItemReservations WishlistItemReservation[] @relation("WishlistItemReservationReservedByUser")
  sentWishlistShareInvitations WishlistShareInvitation[] @relation("WishlistShareInvitationCreatedByUser")
  ownedWishlistShareInvitations WishlistShareInvitation[] @relation("WishlistShareInvitationOwnerUser")
  receivedWishlistShareInvitations WishlistShareInvitation[] @relation("WishlistShareInvitationInvitedUser")
  sentFamilyInvitations FamilyInvitation[] @relation("FamilyInvitationCreatedByUser")
  receivedFamilyInvitations FamilyInvitation[] @relation("FamilyInvitationInvitedUser")
  notificationPreferences NotificationPreference?
  feedbackSubmissions FeedbackSubmission[]
  sessions UserSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  revokedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}



model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  emailHash String
  requestIp String?
  userAgent String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([emailHash, createdAt])
  @@index([requestIp, createdAt])
  @@map("password_reset_tokens")
}

model FeedbackSubmission {
  id         String                 @id @default(cuid())
  type       FeedbackSubmissionType
  message    String
  userId     String
  familyId   String?
  userAgent  String?
  appVersion String?
  createdAt  DateTime               @default(now())
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family     Family?                @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([familyId])
  @@map("feedback_submissions")
}

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  calendarEvents    Boolean  @default(true)
  calendarReminders Boolean  @default(true)
  huskReminders     Boolean  @default(true)
  wishlistShared    Boolean  @default(true)
  familyInvites     Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

model Family {
  id        String         @id @default(cuid())
  name      String
  code      String?        @unique @map("family_code")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   FamilyMember[]
  shoppingLists ShoppingList[]
  mealPlans MealPlan[]
  meals MealPlanDay[]
  tasks     Task[]
  calendarEvents CalendarEvent[]
  calendarIcsSources CalendarIcsSource[]
  calendarExportFeed CalendarExportFeed?
  reminders Reminder[]
  lists     List[]
  wishlistItems WishlistItem[]
  wishlistShareInvitations WishlistShareInvitation[]
  familyInvitations FamilyInvitation[]
  schoolWeekReminders SchoolWeekReminder[]
  feedbackSubmissions FeedbackSubmission[]
  customShoppingItems FamilyCustomShoppingItem[]

  @@map("families")
}

model FamilyMember {
  id          String           @id @default(cuid())
  userId      String?
  familyId    String
  displayName String
  role        FamilyMemberRole
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  calendarEventParticipants CalendarEventParticipant[]
  defaultCalendarIcsSources CalendarIcsSource[]
  reminderAudienceMembers ReminderAudienceMember[]
  listAudienceMembers ListAudienceMember[]
  assignedListItems ListItem[]
  wishlistItems WishlistItem[]
  wishlistShareInvitations WishlistShareInvitation[]
  schoolWeekReminders SchoolWeekReminder[]
  createdMealPlanDays MealPlanDay[]

  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model ShoppingList {
  id            String             @id @default(cuid())
  familyId      String             @map("family_id")
  name          String
  isDefault     Boolean            @default(false) @map("is_default")
  ownerUserId   String?            @map("owner_user_id")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  family        Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ownerUser     User?              @relation("ShoppingListOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  items         ShoppingListItem[]
  accesses      ShoppingListAccess[]
  invitations   ShoppingListInvitation[]

  @@index([familyId])
  @@index([ownerUserId])
  @@map("shopping_lists")
}

model ShoppingListAccess {
  id             String       @id @default(cuid())
  shoppingListId String       @map("shopping_list_id")
  userId         String       @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shoppingListId, userId])
  @@index([userId])
  @@map("shopping_list_access")
}

model ShoppingListInvitation {
  id              String                       @id @default(cuid())
  shoppingListId  String                       @map("shopping_list_id")
  familyId        String                       @map("family_id")
  invitedEmail    String                       @map("invited_email")
  invitedUserId   String?                      @map("invited_user_id")
  tokenHash       String                       @unique @map("token_hash")
  status          ShoppingListInvitationStatus @default(pending)
  createdByUserId String                       @map("created_by_user_id")
  acceptedAt      DateTime?                    @map("accepted_at")
  declinedAt      DateTime?                    @map("declined_at")
  revokedAt       DateTime?                    @map("revoked_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  shoppingList    ShoppingList                 @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  invitedUser     User?                        @relation("ShoppingListInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  createdByUser   User                         @relation("ShoppingListInvitationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
  @@index([familyId])
  @@index([invitedEmail])
  @@index([invitedUserId])
  @@index([status])
  @@map("shopping_list_invitations")
}
model ShoppingListItem {
  id               String       @id @default(cuid())
  shoppingListId   String
  label            String
  quantity         String?
  unit             String?
  note             String?
  category         String?
  checked          Boolean      @default(false)
  createdByUserId  String?
  checkedByUserId  String?
  familyCustomShoppingItemId String? @map("family_custom_shopping_item_id")
  checkedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  shoppingList     ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  createdByUser    User?        @relation("ShoppingItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  checkedByUser    User?        @relation("ShoppingItemCheckedBy", fields: [checkedByUserId], references: [id], onDelete: SetNull)
  familyCustomShoppingItem FamilyCustomShoppingItem? @relation(fields: [familyCustomShoppingItemId], references: [id], onDelete: SetNull)

  @@index([shoppingListId])
  @@index([createdByUserId])
  @@index([checkedByUserId])
  @@index([familyCustomShoppingItemId])
  @@map("shopping_list_items")
}



model FamilyCustomShoppingItem {
  id                String    @id @default(cuid())
  familyId          String    @map("family_id")
  name              String
  normalizedName    String    @map("normalized_name")
  defaultUnit       String    @default("stk") @map("default_unit")
  suggestedQuantity Int       @default(1) @map("suggested_quantity")
  categorySlug      String    @default("egne-varer") @map("category_slug")
  iconKey           String?   @map("icon_key")
  createdByUserId   String?   @map("created_by_user_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  family            Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByUser     User?     @relation("FamilyCustomShoppingItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  shoppingListItems ShoppingListItem[]

  @@index([familyId, normalizedName, deletedAt])
  @@index([familyId, categorySlug, deletedAt])
  @@index([createdByUserId])
  @@map("family_custom_shopping_items")
}

model ShoppingCatalogCategory {
  id        String                @id @default(cuid())
  name      String
  slug      String                @unique
  sortOrder Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     ShoppingCatalogItem[]

  @@index([sortOrder])
  @@map("shopping_catalog_categories")
}

model ShoppingCatalogItem {
  id             String                  @id @default(cuid())
  categoryId     String
  name           String
  normalizedName String                  @unique
  aliases        String[]                @default([])
  searchValues   String[]                @default([])
  defaultUnit    String
  suggestedQuantity Int
  sortOrder      Int
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  category       ShoppingCatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
  @@index([normalizedName])
  @@map("shopping_catalog_items")
}

model MealPlan {
  id        String        @id @default(cuid())
  familyId  String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  days      MealPlanDay[]

  @@index([familyId])
  @@map("meal_plans")
}

model MealPlanDay {
  id                      String        @id @default(cuid())
  mealPlanId              String
  familyId                String
  date                    DateTime
  mealName                String
  notes                   String?
  createdByFamilyMemberId String?
  sortOrder               Int?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?
  mealPlan                MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  family                  Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByFamilyMember   FamilyMember? @relation(fields: [createdByFamilyMemberId], references: [id], onDelete: SetNull)

  @@unique([familyId, date])
  @@unique([mealPlanId, date])
  @@index([mealPlanId])
  @@index([familyId])
  @@index([createdByFamilyMemberId])
  @@index([date])
  @@index([deletedAt])
  @@map("meal_plan_days")
}

model Task {
  id                     String        @id @default(cuid())
  familyId               String
  title                  String
  description            String?
  assignedFamilyMemberId String?
  assignedMemberIds      String[]      @default([])
  createdByUserId        String?
  completed              Boolean       @default(false)
  completedAt            DateTime?
  completedByUserId      String?
  dueDate                DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  family                 Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignedFamilyMember   FamilyMember? @relation(fields: [assignedFamilyMemberId], references: [id], onDelete: SetNull)
  createdByUser          User?         @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUser        User?         @relation("TaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([assignedFamilyMemberId])
  @@index([createdByUserId])
  @@index([completedByUserId])
  @@map("tasks")
}


model CalendarEvent {
  id              String                     @id @default(cuid())
  familyId        String
  title           String
  description     String?
  location        String?
  icon            String                     @default("family")
  reminderMinutesBefore Int?
  startsAt        DateTime
  endsAt          DateTime?
  allDay          Boolean                    @default(false)
  source          String                     @default("manual")
  icsSourceId     String?
  externalUid     String?
  externalLastModified DateTime?
  externalSequence Int?
  importedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  family          Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  icsSource       CalendarIcsSource?         @relation(fields: [icsSourceId], references: [id], onDelete: Cascade)
  createdByUser   User?                      @relation("CalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants    CalendarEventParticipant[]

  @@index([familyId])
  @@index([startsAt])
  @@index([endsAt])
  @@unique([icsSourceId, externalUid])
  @@index([createdByUserId])
  @@index([icsSourceId])
  @@index([source])
  @@map("calendar_events")
}


model CalendarIcsSource {
  id                    String          @id @default(cuid())
  familyId              String
  name                  String
  url                   String
  active                Boolean         @default(true)
  defaultFamilyMemberId String?
  defaultCategory       String          @default("family")
  lastSyncedAt          DateTime?
  lastSyncStatus        String?
  lastSyncError         String?
  syncIntervalMinutes   Int             @default(60)
  nextSyncAt            DateTime?
  lastSyncStartedAt     DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  family                Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  defaultFamilyMember   FamilyMember?   @relation(fields: [defaultFamilyMemberId], references: [id], onDelete: SetNull)
  events                CalendarEvent[]

  @@index([familyId])
  @@index([defaultFamilyMemberId])
  @@index([active, nextSyncAt])
  @@map("calendar_ics_sources")
}

model CalendarExportFeed {
  id                         String   @id @default(cuid())
  familyId                   String   @unique
  token                      String   @unique
  enabled                    Boolean  @default(false)
  includeEvents              Boolean  @default(true)
  includeMeals               Boolean  @default(true)
  includeReminders           Boolean  @default(true)
  includeSchoolWeekReminders Boolean  @default(true)
  scope                      String   @default("family")
  selectedFamilyMemberId     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  family                     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("calendar_export_feeds")
}

model CalendarEventParticipant {
  id             String         @id @default(cuid())
  eventId        String
  familyMemberId String
  createdAt      DateTime       @default(now())
  event          CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember   @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, familyMemberId])
  @@index([eventId])
  @@index([familyMemberId])
  @@map("calendar_event_participants")
}



model Reminder {
  id                    String                   @id @default(cuid())
  familyId              String
  title                 String
  icon                  String                   @default("backpack")
  dueDate               DateTime?
  reminderMinutesBefore Int?
  note                  String?
  sourceType            String?                  @map("source_type")
  sourceId              String?                  @map("source_id")
  isPrivate             Boolean                  @default(false)
  createdByUserId       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  archivedAt            DateTime?
  family                Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByUser         User?                    @relation("ReminderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  audienceMembers       ReminderAudienceMember[]

  @@unique([createdByUserId, sourceType, sourceId])
  @@index([familyId])
  @@index([dueDate])
  @@index([createdByUserId])
  @@index([sourceType, sourceId])
  @@index([familyId, isPrivate, createdByUserId])
  @@map("reminders")
}

model ReminderAudienceMember {
  id             String       @id @default(cuid())
  reminderId     String
  familyMemberId String
  createdAt      DateTime     @default(now())
  reminder       Reminder     @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([reminderId, familyMemberId])
  @@index([reminderId])
  @@index([familyMemberId])
  @@map("reminder_audience_members")
}

model List {
  id              String               @id @default(cuid())
  familyId        String
  title           String
  icon            String               @default("home")
  description     String?
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  audienceMembers ListAudienceMember[]
  items           ListItem[]

  @@index([familyId])
  @@map("husk_lists")
}

model ListAudienceMember {
  id             String       @id @default(cuid())
  listId         String
  familyMemberId String
  createdAt      DateTime     @default(now())
  list           List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([listId, familyMemberId])
  @@index([listId])
  @@index([familyMemberId])
  @@map("husk_list_audience_members")
}

model ListItem {
  id                     String        @id @default(cuid())
  listId                 String
  title                  String
  description            String?
  completedAt            DateTime?
  assignedFamilyMemberId String?
  dueDate                DateTime?
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  list                   List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignedFamilyMember   FamilyMember? @relation(fields: [assignedFamilyMemberId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([assignedFamilyMemberId])
  @@map("husk_list_items")
}

model WishlistItemReservation {
  id                 String       @id @default(cuid())
  wishlistItemId     String       @map("wishlist_item_id")
  reservedByUserId   String       @map("reserved_by_user_id")
  reservedAt         DateTime     @default(now()) @map("reserved_at")
  releasedAt         DateTime?    @map("released_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  wishlistItem       WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)
  reservedByUser     User         @relation("WishlistItemReservationReservedByUser", fields: [reservedByUserId], references: [id], onDelete: Cascade)

  @@index([wishlistItemId])
  @@index([reservedByUserId])
  @@index([wishlistItemId, releasedAt])
  @@map("wishlist_item_reservations")
}

model FamilyInvitation {
  id              String                 @id @default(cuid())
  familyId        String
  invitedEmail    String
  invitedUserId   String?
  role            FamilyMemberRole
  tokenHash       String                 @unique
  status          FamilyInvitationStatus @default(pending)
  source          FamilyInvitationSource @default(admin_invite)
  createdByUserId String
  acceptedAt      DateTime?
  declinedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  family          Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedUser     User?                  @relation("FamilyInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  createdByUser   User                   @relation("FamilyInvitationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([familyId, status, source])
  @@index([invitedEmail])
  @@index([invitedUserId])
  @@index([status])
  @@map("family_invitations")
}

model WishlistShareInvitation {
  id                          String                        @id @default(cuid())
  wishlistOwnerUserId         String                        @map("wishlist_owner_user_id")
  wishlistOwnerFamilyMemberId String?                       @map("wishlist_owner_family_member_id")
  familyId                    String                        @map("family_id")
  invitedEmail                String                        @map("invited_email")
  invitedUserId               String?                       @map("invited_user_id")
  tokenHash                   String                        @unique @map("token_hash")
  status                      WishlistShareInvitationStatus @default(pending)
  createdByUserId             String                        @map("created_by_user_id")
  acceptedAt                  DateTime?                     @map("accepted_at")
  declinedAt                  DateTime?                     @map("declined_at")
  removedAt                   DateTime?                     @map("removed_at")
  revokedAt                   DateTime?                     @map("revoked_at")
  expiresAt                   DateTime?                     @map("expires_at")
  createdAt                   DateTime                      @default(now()) @map("created_at")
  updatedAt                   DateTime                      @updatedAt @map("updated_at")
  family                      Family                        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wishlistOwnerUser           User                          @relation("WishlistShareInvitationOwnerUser", fields: [wishlistOwnerUserId], references: [id], onDelete: Cascade)
  wishlistOwnerFamilyMember   FamilyMember?                 @relation(fields: [wishlistOwnerFamilyMemberId], references: [id], onDelete: SetNull)
  invitedUser                 User?                         @relation("WishlistShareInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  createdByUser               User                          @relation("WishlistShareInvitationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([wishlistOwnerUserId])
  @@index([wishlistOwnerFamilyMemberId])
  @@index([familyId])
  @@index([familyId, status])
  @@index([invitedEmail])
  @@index([invitedUserId])
  @@index([status])
  @@map("wishlist_share_invitations")
}

model SchoolWeekReminder {
  id                    String                @id @default(cuid())
  familyId              String
  childFamilyMemberId   String
  title                 String
  icon                  String                @default("backpack")
  weekday               String
  date                  DateTime?
  isRecurring           Boolean               @default(false)
  recurrenceFrequency   String                @default("weekly")
  recurrenceEndDate     DateTime?
  recurringSeriesId     String?
  exceptionOfId         String?
  note                  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  family                Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childFamilyMember     FamilyMember          @relation(fields: [childFamilyMemberId], references: [id], onDelete: Cascade)
  exceptionOf           SchoolWeekReminder?   @relation("SchoolWeekReminderExceptions", fields: [exceptionOfId], references: [id], onDelete: Cascade)
  exceptions            SchoolWeekReminder[]  @relation("SchoolWeekReminderExceptions")

  @@index([familyId])
  @@index([childFamilyMemberId])
  @@index([date])
  @@index([exceptionOfId])
  @@index([recurringSeriesId])
  @@map("school_week_reminders")
}

model WishlistItem {
  id                    String        @id @default(cuid())
  familyId              String        @map("family_id")
  ownerUserId           String        @map("owner_user_id")
  ownerFamilyMemberId   String?       @map("owner_family_member_id")
  title                 String
  description           String?
  price                 Decimal?      @db.Decimal(10, 2)
  storeOrLink           String?       @map("store_or_link")
  imageUrl              String?       @map("image_url")
  icon                  String?
  position              Int
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  family                Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ownerUser             User          @relation("WishlistItemOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerFamilyMember     FamilyMember? @relation(fields: [ownerFamilyMemberId], references: [id], onDelete: SetNull)
  reservations          WishlistItemReservation[]

  @@index([familyId])
  @@index([ownerUserId])
  @@index([ownerFamilyMemberId])
  @@index([familyId, ownerUserId, deletedAt, position])
  @@map("wishlist_items")
}
